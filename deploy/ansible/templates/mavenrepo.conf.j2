# Managed by Ansible -- see deploy/ansible/playbook.yml. Manual edits will be
# overwritten on the next run. For a hand-installed single host instead, see
# deploy/nginx/mavenrepo.conf.

upstream mavenrepo {
    server 127.0.0.1:{{ mavenrepo_bind_port }};
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ mavenrepo_domain }};

    # Don't hand an attacker the exact nginx version for free.
    server_tokens off;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ mavenrepo_domain }};

    # Don't hand an attacker the exact nginx version for free.
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/{{ mavenrepo_domain }}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/{{ mavenrepo_domain }}/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:mavenrepo_ssl:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;

    # mvn deploy uploads (jars/wars/zips) can be sizeable; raise nginx's default 1m cap.
    client_max_body_size 500m;
    # Stream uploads straight to the upstream instead of buffering the whole
    # request body to disk first -- matters for large artifact PUTs.
    proxy_request_buffering off;

    location / {
{% if mavenrepo_read_only %}
        # Defense in depth: mavenrepo itself already rejects PUT/DELETE via
        # -read-only, but reject them here too so nginx never even forwards
        # a write to the backend, regardless of app-level config drift.
        limit_except GET HEAD {
            deny all;
        }
{% endif %}
        proxy_pass http://mavenrepo;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
