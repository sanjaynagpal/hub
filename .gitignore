# Build output
/mavenrepo
/mavenrepo-*
/acmeclient
/acmeclient-*
*.exe

# Local repository data / test dirs created at runtime
/repo/
/testrepo/
/data/

# Ansible: never commit a decrypted vault, or the cross-compiled binaries
# the playbook builds locally before copying them to target hosts.
/deploy/ansible/group_vars/**/vault.yml
/deploy/ansible/files/mavenrepo-linux-*
/deploy/ansible/files/acmeclient-linux-*

# OS / editor cruft
.DS_Store
Thumbs.db
